@model IReadOnlyList<AllenBuilding.Application.Maintenance.RequestSummary>
@{ var manager = ViewData["Manager"] is true; }
    <ul class="space-y-4">
        @foreach (var request in Model)
        {
            <li><a asp-action="@(manager ? "ManageDetails" : "Details")" asp-route-id="@request.Id" class="block rounded-xl border border-line bg-panel p-5 hover:ring-2 hover:ring-brand">
                <div class="flex flex-wrap items-start justify-between gap-3"><h2 class="min-w-0 break-words text-xl font-semibold">@request.Title</h2><span class="rounded-lg bg-brand-soft px-3 py-1 text-sm">@MaintenanceText.Status(request.Status)</span></div>
                <p class="mt-2 text-sm text-muted">@request.Suite · Submitted @OfficeTime.Date(request.CreatedAt)</p>
                @if (manager) {
                    var observed = (DateTimeOffset)ViewData["ObservedAt"]!;
                    var age = Math.Max(0, (int)(observed - request.CreatedAt).TotalDays);
                    <p class="mt-2 text-sm text-muted">@age days since submission · @(request.Priority?.ToString() ?? "Awaiting triage") @(request.Trade is not null ? "· " + MaintenanceText.Trade(request.Trade) : "")</p>
                    <p class="mt-2 text-sm text-muted">@(request.Assignment is null ? "Unassigned" : "Assigned to: " + request.Assignment)</p>
                }
            </a></li>
        }
    </ul>
