@model IReadOnlyList<AllenBuilding.Application.Maintenance.RequestSummary>
@{ ViewData["Title"] = "Maintenance"; var manager = ViewData["Manager"] is true; }
<div class="page">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div><p class="mb-2 text-sm text-muted">ALLEN BUILDING</p><h1 class="text-4xl font-semibold">@(manager ? "Maintenance overview" : "Your maintenance requests")</h1></div>
        @if (manager) { <a asp-action="CreateOnBehalf" class="button">Record a tenant request</a> }
        else { <a asp-action="Create" class="button">Report an issue</a> }
    </div>
    @if (Model.Count == 0) { <p class="rounded-xl border border-line bg-panel p-6">No requests to show.</p> }
    <partial name="_RequestList" model="Model" />
    @if (Model.Count == 100) { <p class="mt-4 text-sm text-muted">Showing the 100 most recent requests.</p> }
    <a asp-controller="Portal" asp-action="Index" class="mt-6 flex min-h-11 items-center underline">Return to your office</a>
</div>
