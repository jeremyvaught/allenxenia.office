@model AllenBuilding.Application.Assistant.AssistantAnswer
@{ ViewData["Title"] = "Ask the office assistant"; var enabled = ViewData["Enabled"] is true; }
<div class="page max-w-3xl">
    <p class="mb-2 text-sm font-semibold tracking-widest text-brand">A LITTLE HELP, RIGHT HERE</p>
    <h1 class="mb-4 text-3xl font-semibold sm:text-4xl">Ask the office assistant</h1>
    <p class="mb-6 leading-relaxed text-muted">Find published building guidance and the right page for your next step. For immediate danger, contact emergency services. This assistant cannot dispatch help.</p>
    <div data-assistant-result data-assistant-membership="@Model?.Scope?.MembershipId" data-assistant-conversation="@ViewData["ActiveConversation"]" aria-live="polite" aria-atomic="true" class="mb-6 rounded-2xl border border-line bg-panel p-5 sm:p-6">
    @if (Model?.Code == AllenBuilding.Application.Assistant.AssistantModelCode.Success)
    {
        @if (Model.History?.Count > 0)
        {
            <details class="mb-5 border-b border-line pb-4">
                <summary class="cursor-pointer py-3 font-semibold">Earlier messages in this conversation</summary>
                <ol class="mt-3 space-y-4">@foreach (var exchange in Model.History) {
                    <li class="min-w-0 rounded-xl border border-line p-4"><p class="mb-2 font-semibold">You</p><p class="mb-4 whitespace-pre-wrap break-words">@exchange.Question</p><p class="mb-2 font-semibold">Office assistant</p><p class="whitespace-pre-wrap break-words">@exchange.Answer</p></li>
                }</ol>
            </details>
        }
        <h2 class="mb-3 text-lg font-semibold">Office assistant</h2>
        @if (Model.Scope is not null) { <p class="mb-3 break-words text-sm text-muted">Tenant guidance · @Model.Scope.Suite</p> }
        <p class="whitespace-pre-wrap break-words leading-relaxed">@Model.Text</p>
        <p class="mt-4 text-sm text-muted">This answer hasn't submitted a request, comment or payment.</p>
        @if (Model.Target is not null) { <p class="mt-4 break-words font-semibold">Selected request: @Model.Target.Title</p> }
        @if (Model.Review is not null)
        {
            <section class="mt-6 border-t border-line pt-5" aria-label="Prepared maintenance draft">
                <h3 class="mb-3 font-semibold">A draft is ready for your review</h3>
                <p class="mb-4">Nothing has been submitted. Check the exact details, edit or cancel, and confirm on the review page.</p>
                <a class="button" href="/Assistant/Review/@Model.Review.Review.Id?conversationId=@Model.Review.Review.ConversationId">Review @(Model.Review.Review.Kind == AllenBuilding.Domain.Maintenance.AssistantReviewKind.Request ? "maintenance request" : "comment")</a>
            </section>
        }
        @if (Model.Requests is not null)
        {
            <section aria-label="Your maintenance records" class="mt-6 border-t border-line pt-5">
                <h3 class="mb-3 font-semibold">Your maintenance records</h3>
                @if (Model.RecordsCheckedAt is { } checkedAt) { <p class="mb-3 text-sm text-muted">Checked @checkedAt.ToString("MMM d, yyyy HH:mm:ss 'UTC'"). Open a request to view updates.</p> }
                <form asp-action="Find" method="post" class="mb-5 space-y-3">
                    <input type="hidden" name="membershipId" value="@Model.Scope!.MembershipId" />
                    <label for="request-search" class="block font-semibold">Find a request by title or location</label>
                    <input id="request-search" name="search" type="search" maxlength="120" value="@Model.RequestSearch" class="field" required />
                    <button class="quiet-button">Search your requests</button>
                </form>
                @if (Model.Requests.Count == 0) { <p>@(Model.RequestSearch is null ? "No requests are available for this membership." : "No matching requests. Try another title or location.")</p> }
                <ul class="space-y-4">@foreach (var request in Model.Requests) {
                    <li class="min-w-0 rounded-xl border border-line p-4"><h4 class="break-words font-semibold">@request.Title</h4><p class="mt-2">Status: @MaintenanceText.Status(request.Status)</p><p class="mt-2 text-sm text-muted">Submitted @request.CreatedAt.ToString("MMM d, yyyy HH:mm 'UTC'")</p><a href="/Maintenance/Details/@request.Id" class="quiet-button mt-3">View request</a>@if (ViewData["ActionsEnabled"] is true) { <a class="quiet-button mt-3" href="/Assistant?membershipId=@Model.Scope!.MembershipId&amp;requestId=@request.Id">Prepare a comment</a> }</li>
                }</ul>
                <p class="mt-3 text-sm text-muted">Showing up to five @(Model.RequestSearch is null ? "recent" : "matching") requests for this membership. Open a request for its history and current status.</p>
            </section>
        }
        @if (Model.Billing is not null)
        {
            <section aria-label="Your billing records" class="mt-6 border-t border-line pt-5">
                <h3 class="mb-3 font-semibold">Your billing records</h3>
                @if (Model.RecordsCheckedAt is { } checkedAt) { <p class="mb-3 text-sm text-muted">Checked @checkedAt.ToString("MMM d, yyyy HH:mm:ss 'UTC'"). Open your account to view updates.</p> }
                <p class="mb-4 text-sm leading-relaxed text-muted">These are issued charges and recorded credits, not an outstanding balance. Payment status isn't included here. Open your account to review its records and available options.</p>
                @if (Model.Billing.Count == 0) { <p>No billing account is available for this membership.</p> }
                @foreach (var account in Model.Billing) {
                    <h4 class="mb-3 break-words font-semibold">@account.Suite</h4>
                    @if (account.Obligations.Count == 0) { <p>No charges have been issued.</p> }
                    <ul class="space-y-4">@foreach (var charge in account.Obligations.Take(5)) {
                        <li class="min-w-0 rounded-xl border border-line p-4"><h5 class="break-words font-semibold">@charge.Description</h5><p class="mt-2">Issued: @BillingDisplay.Usd(charge.IssuedMinorUnits) USD</p><p class="mt-2 text-sm text-muted">Due @charge.DueOn.ToString("yyyy-MM-dd")</p>@if (charge.CreditedMinorUnits > 0) { <p class="mt-2">Recorded credits: @BillingDisplay.Usd(charge.CreditedMinorUnits) USD</p><p class="mt-2">Charge after credits: @BillingDisplay.Usd(charge.NetChargeMinorUnits) USD</p> }</li>
                    }</ul>
                    <p class="mt-3 text-sm text-muted">Showing up to five charges, ordered by due date.</p><a href="/Billing/Account/@account.Id" class="quiet-button mt-3">Open billing account</a>
                }
            </section>
        }
        @if (Model.Sources?.Count > 0)
        {
            <h3 class="mt-5 font-semibold">Published sources</h3>
            <ul class="mt-2 space-y-2">@foreach (var source in Model.Sources) {
                <li><a href="/Knowledge/@(source.Audience == AllenBuilding.Domain.Knowledge.ArticleAudience.ActiveTenant ? "TenantArticle" : "Article")/@source.ArticleId" class="inline-flex min-h-11 items-center break-words text-brand underline">@source.Title</a><p class="text-sm text-muted">Review date: @source.ReviewOn.ToString("MMM d, yyyy")</p></li>
            }</ul>
        }
        @if (Model.Next is not null && Model.Review is null) { <a href="@Model.Next.Path" class="quiet-button mt-5">@Model.Next.Label</a> }
    }
    else if (ViewData["SearchInvalid"] is true) { <p>Enter a title or location of up to 120 characters. <a href="/Maintenance" class="underline">Open your requests to search again</a>.</p> }
    else if (ViewData["ConversationUnavailable"] is true) { <p>This conversation is busy, expired or no longer available. Start fresh using the link below. No action was submitted.</p> }
    else if (ViewData["Limited"] is true) { <p>You've reached the assistant's current limit. Try again later, or open building help.</p> }
    else if (Model?.Code == AllenBuilding.Application.Assistant.AssistantModelCode.Invalid) { <p>Please ask a question of up to 4,000 characters. If an answer could not be verified, try rephrasing or open building help.</p> }
    else if (Model?.Code == AllenBuilding.Application.Assistant.AssistantModelCode.Denied) { <p>This guidance scope is unavailable. Start a new question using your current access.</p> }
    else if (Model is not null || !enabled) { <p>The assistant is unavailable right now. You can still use <a href="/Knowledge" class="underline">building help</a> and <a href="/Portal" class="underline">your office</a>.</p> }
    else { <p>Try “How do I report a repair?” or ask about published building guidance.</p> }
    </div>
    @if (enabled && Model?.Requests is null && ViewData["Memberships"] is IReadOnlyList<AllenBuilding.Application.Maintenance.RequestMemberChoice> searchMembers && searchMembers.Count > 0)
    {
        <details class="mb-6 rounded-2xl border border-line bg-panel p-5 sm:p-6">
            <summary class="cursor-pointer py-3 font-semibold">Find a maintenance request</summary>
            <form asp-action="Find" method="post" class="mt-4 space-y-3">
                <label for="search-membership" class="block font-semibold">Search requests for</label>
                <select id="search-membership" name="membershipId" class="field">@foreach (var member in searchMembers) { <option value="@member.Id">@member.Suite</option> }</select>
                <label for="initial-search" class="block font-semibold">Request title or location</label>
                <input id="initial-search" name="search" type="search" maxlength="120" class="field" required />
                <button class="quiet-button">Search your requests</button>
            </form>
        </details>
    }
    @if (enabled && ViewData["ConversationClosed"] is not true)
    {
        <form asp-action="Ask" method="post" data-assistant-form class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
            <input type="hidden" name="conversationId" value="@ViewData["ConversationId"]" />
            <input type="hidden" name="sequence" value="@(ViewData["Sequence"] ?? 0)" />
            @if (Model?.Target is not null) { <input type="hidden" name="requestId" value="@Model.Target.Id" /> }
            <label for="membershipId" class="mb-2 block font-semibold">Guidance for</label>
            <select id="membershipId" name="membershipId" class="field mb-5">
                <option value="">Public building help</option>
                @foreach (var member in ViewData["Memberships"] as IReadOnlyList<AllenBuilding.Application.Maintenance.RequestMemberChoice> ?? []) {
                    <option value="@member.Id" selected="@(ViewData["SelectedMembership"] is Guid selected && selected == member.Id)">Tenant help · @member.Suite</option>
                }
            </select>
            <label for="question" class="mb-2 block font-semibold">Your question</label>
            <textarea id="question" name="question" rows="4" maxlength="4000" required class="field" aria-describedby="assistant-privacy"></textarea>
            <p id="assistant-privacy" class="mt-3 text-sm leading-relaxed text-muted">Your question, matching published guidance and earlier messages in this conversation are sent to OpenAI. Don't include passwords, payment details or sensitive personal information. @(ViewData["FollowUpsEnabled"] is true ? "This temporary conversation is available for up to six questions, thirty minutes of inactivity or two hours total. Expired messages are removed from server memory within a minute; a restart clears them. Start fresh to change scope." : "Each question starts fresh.") Prepared drafts and confirmation records are stored securely in your account.</p>
            <div class="mt-5 flex flex-wrap items-center gap-3"><button class="button" data-assistant-send>Ask assistant</button><button type="button" class="quiet-button" data-assistant-stop hidden>Stop</button><p data-assistant-progress role="status" class="text-sm text-muted"></p></div>
        </form>
    }
    else if (enabled) { <p class="text-sm text-muted">@(Model?.Review is not null ? "Open the review above to edit, cancel or confirm your draft." : "This conversation reached its limit.") Start fresh for another question.</p> }
    <div class="mt-6 flex flex-wrap gap-3"><a href="/Knowledge" class="quiet-button">Browse building help</a><a href="/Assistant" class="quiet-button">Start fresh or change scope</a><a href="/Portal" class="quiet-button">Your office</a></div>
</div>
@section Scripts { <script src="~/js/assistant.js" asp-append-version="true" defer></script> }
