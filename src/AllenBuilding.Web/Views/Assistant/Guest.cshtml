@model AllenBuilding.Web.Hosting.AssistantGuestDraft
@{ ViewData["Title"] = "Continue your maintenance draft"; var members = ViewData["Memberships"] as IReadOnlyList<AllenBuilding.Application.Maintenance.RequestMemberChoice> ?? []; }
<div class="page max-w-3xl">
    <h1 class="mb-4 text-3xl font-semibold">Your maintenance draft</h1>
    <p class="mb-5 text-muted">Nothing has been submitted. This temporary draft expires at @Model.ExpiresAt.ToString("HH:mm:ss 'UTC'") and is cleared if the server restarts. Sign in, choose your office and review it before separately confirming.</p>
    @if (Model.ImportedScope is null)
    {
        <form asp-action="EditGuest" method="post" class="space-y-4 rounded-2xl border border-line bg-panel p-5 sm:p-6">
            <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="version" value="@Model.Version" />
            <label class="block font-semibold" for="draft-title">Title</label><input id="draft-title" name="title" class="field" maxlength="120" value="@Model.Draft.Title" required />
            <label class="block font-semibold" for="draft-location">Location</label><input id="draft-location" name="location" class="field" maxlength="160" value="@Model.Draft.Location" required />
            <label class="block font-semibold" for="draft-description">Details</label><textarea id="draft-description" name="description" class="field" maxlength="4000" rows="5" required>@Model.Draft.Description</textarea>
            <div class="flex flex-wrap gap-3"><button class="quiet-button">Save draft changes</button><button class="quiet-button" name="cancel" value="true" formnovalidate>Cancel draft</button></div>
        </form>
    }
    else { <p class="mb-5">This draft is reserved for @Model.ImportedScope.Suite. Continue to retry its review. It cannot be moved to another office or account.</p> }
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a href="/Account/Login" class="button mt-6">Sign in to continue</a>
        <p class="mt-3 text-sm text-muted">After signing in, use “Continue your maintenance draft” to return here. Signing in does not submit it.</p>
    }
    else if (members.Count > 0)
    {
        <form asp-action="ImportGuest" method="post" class="mt-6 space-y-4 rounded-2xl border border-line bg-panel p-5 sm:p-6">
            <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="version" value="@Model.Version" />
            <label for="draft-membership" class="block font-semibold">Prepare a review for</label>
            <select id="draft-membership" name="membershipId" class="field" required><option value="">Choose your office</option>@foreach (var member in members) { <option value="@member.Id">@member.Suite</option> }</select>
            <p class="text-sm text-muted">Only these draft details transfer into your account. Check the exact review next; submission requires a separate confirmation.</p>
            <button class="button">Prepare my review</button>
        </form>
    }
    else { <p class="mt-6">You do not currently have tenant access to an office. Contact management; this draft has not been submitted.</p> }
    <a href="/Assistant" class="quiet-button mt-6">Back to assistant</a>
</div>
