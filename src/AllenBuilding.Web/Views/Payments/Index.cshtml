@model AllenBuilding.Web.Controllers.PaymentSelection
@{ ViewData["Title"] = "Review a payment"; }
<div class="page max-w-3xl">
    <p class="mb-2 text-sm text-muted">@Model.Account.Suite · PAYMENTS</p><h1 class="mb-4 text-4xl font-semibold">Choose what to pay</h1>
    <p class="mb-6 text-muted">Choose one charge and any small balances for this account. You’ll review the exact amount before continuing to secure checkout.</p>
    <form asp-action="Prepare" method="post" class="space-y-4">
        <input type="hidden" name="accountId" value="@Model.Account.Id" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" />
        <fieldset class="space-y-3"><legend class="mb-3 font-semibold">Recorded balances</legend>
        @foreach (var item in Model.Balances)
        {
            var debt = Model.Account.Obligations.Single(x => x.Id == item.ObligationId); var held = item.Held || item.HasProviderInstruction; var selectable = !held && item.RemainingMinorUnits > 0;
            <label class="flex min-w-0 items-start gap-3 rounded-2xl border border-line bg-panel p-5">
                <input type="checkbox" name="obligationIds" value="@item.ObligationId" disabled="@(!selectable)" class="mt-2 size-5 shrink-0" />
                <span class="min-w-0"><span class="block break-words font-semibold">@debt.Description</span><span class="mt-1 block">@BillingDisplay.Usd(item.RemainingMinorUnits) USD remaining</span>
                    <span class="mt-1 block text-sm text-muted">Due @debt.DueOn.ToString("yyyy-MM-dd")</span>
                    @if (held) { <span class="mt-2 block text-sm">Checking this account. Contact your manager before paying again.</span> }
                    else if (item.RemainingMinorUnits == 0) { <span class="mt-2 block text-sm">No payment needed.</span> }
                    else if (item.RemainingMinorUnits < 50) { <span class="mt-2 block text-sm">This small balance remains owed. Include it with an eligible payment; it is never silently written off.</span> }
                </span>
            </label>
        }
        </fieldset>
        <p class="text-sm text-muted">Showing up to 100 obligations. Select at most 25 items, including at most one balance of $0.50 or more. Combined collection must be at least $0.50.</p>
        <button class="button">Review selected payment</button>
    </form>
    @if (Model.Recent.Count > 0) {
        <section class="mt-8"><h2 class="mb-4 text-2xl font-semibold">Recent payment requests</h2><ul class="space-y-3">
        @foreach (var payment in Model.Recent) { <li class="rounded-xl border border-line bg-panel p-5"><p>@BillingDisplay.Usd(payment.TotalMinorUnits) USD · @OfficeTime.Timestamp(payment.CreatedAt.ToUniversalTime())</p><a asp-action="Status" asp-route-id="@payment.AttemptId" class="mt-2 flex min-h-11 items-center underline">View payment @(payment.AttemptId.ToString("N")[..8])</a></li> }
        </ul><p class="mt-3 text-sm text-muted">Showing up to 50 requests. Open a payment to check its verified status.</p></section>
    }
    <a asp-controller="Billing" asp-action="Account" asp-route-id="@Model.Account.Id" class="mt-6 flex min-h-11 items-center underline">Return to billing</a>
</div>
