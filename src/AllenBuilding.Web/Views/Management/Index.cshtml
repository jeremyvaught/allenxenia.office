@model AllenBuilding.Application.Access.BuildingAccessOverview
@{ ViewData["Title"] = "Building access"; var buildings = Model.Buildings; }
<div class="page"><h1 class="mb-3 text-4xl font-semibold">Building access</h1><p class="mb-6 text-muted">Add suites, invite tenants and remove access. Changes need a recent sign-in with your authenticator.</p>
<div class="grid gap-6 md:grid-cols-2"><section class="rounded-2xl border border-line bg-panel p-6"><h2 class="mb-5 text-xl font-semibold">Add a suite</h2><form asp-action="AddSuite" method="post" class="space-y-5"><div><label for="building" class="mb-2 block">Building</label><select id="building" name="BuildingId" class="field">@foreach (var building in buildings) { <option value="@building.Id">@building.Name</option> }</select></div><div><label for="suite-name" class="mb-2 block">Suite name</label><input id="suite-name" name="Name" maxlength="80" required class="field" /></div><button class="button">Add suite</button></form></section>
<section class="rounded-2xl border border-line bg-panel p-6"><h2 class="mb-5 text-xl font-semibold">Invite a tenant</h2><form asp-action="Invite" method="post" class="space-y-5"><div><label for="suite" class="mb-2 block">Suite</label><select id="suite" name="SuiteId" class="field">@foreach (var suite in Model.Suites) { <option value="@suite.Id">@suite.Name</option> }</select></div><div><label for="invite-email" class="mb-2 block">Email</label><input id="invite-email" name="Email" type="email" maxlength="256" required autocomplete="email" class="field" /></div><button class="button" disabled="@(Model.Suites.Count == 0)">Send invitation</button></form></section></div>
<section class="mt-6 rounded-2xl border border-line bg-panel p-6"><h2 class="mb-3 text-xl font-semibold">Grant another suite to an existing account</h2><p class="mb-5 text-muted">For someone who already has an account here. A returning tenant starts fresh; their earlier requests are not restored.</p>
    <form asp-action="Grant" method="post" class="space-y-4"><input name="OperationId" value="@Guid.NewGuid()" type="hidden" />
        <label for="existing-suite" class="block">Suite for existing account</label><select id="existing-suite" name="SuiteId" class="field">@foreach (var suite in Model.Suites) { <option value="@suite.Id">@suite.Name</option> }</select>
        <label for="existing-email" class="block">Existing account email</label><input id="existing-email" name="Email" type="email" maxlength="256" required class="field" />
        <label for="grant-reason" class="block">Reason for granting access</label><input id="grant-reason" name="Reason" maxlength="2000" required class="field" />
        <button class="button" disabled="@(Model.Suites.Count == 0)">Grant access to this suite</button>
    </form>
</section>
<section class="mt-8"><h2 class="mb-4 text-2xl font-semibold">Unaccepted invitations</h2><div class="grid gap-4 md:grid-cols-2">
@if (Model.Invitations.Count == 0) { <p class="text-muted md:col-span-2">No invitations are waiting.</p> }
@foreach (var invitation in Model.Invitations)
{
    <article class="min-w-0 rounded-2xl border border-line bg-panel p-5"><h3 class="break-words font-semibold">@invitation.Email · @invitation.Suite</h3><p class="my-3 text-sm text-muted">@invitation.Status · Expires @OfficeTime.Timestamp(invitation.ExpiresAt)</p>
        <form asp-action="ChangeInvitation" method="post" class="space-y-3"><input name="InvitationId" value="@invitation.Id" type="hidden" /><input name="Version" value="@invitation.Version" type="hidden" />
            <label for="invitation-reason-@invitation.Id" class="block">Reason for invitation change</label><input id="invitation-reason-@invitation.Id" name="Reason" maxlength="2000" required class="field" />
            <p class="text-sm text-muted">Reissuing sends a new link that works for seven days and cancels the old one. Revoking stops an unused invitation; it does not remove access someone already has.</p>
            <div class="flex flex-wrap gap-3"><button name="Revoke" value="false" class="quiet-button">Reissue invitation</button>@if (invitation.Status != "Revoked") { <button name="Revoke" value="true" class="quiet-button">Revoke invitation</button> }</div>
        </form>
    </article>
}
</div></section>
<section class="mt-8"><h2 class="mb-4 text-2xl font-semibold">Tenant access</h2><ul class="space-y-4">
@if (Model.Access.Count == 0) { <li class="text-muted">No tenants have access yet.</li> }
@foreach (var access in Model.Access)
{
    <li class="rounded-xl border border-line bg-panel p-5"><h3 class="mb-4 break-all font-semibold">@access.Email · @access.Suite</h3><form asp-action="Revoke" method="post" class="space-y-3"><input name="MembershipId" value="@access.Id" type="hidden" /><input name="Version" value="@access.Version" type="hidden" /><label for="reason-@access.Id" class="block">Reason for revoking access</label><input id="reason-@access.Id" name="Reason" maxlength="2000" required class="field" /><p class="text-sm text-muted">Removes this person's portal access right away. Their past requests are kept.</p><button class="quiet-button">Revoke tenant access</button></form></li>
}
</ul></section>
<a asp-controller="Account" asp-action="Reauthenticate" class="mt-6 flex min-h-11 items-center underline">Verify your sign-in to make changes</a></div>
