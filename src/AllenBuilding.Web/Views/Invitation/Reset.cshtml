@model ResetForm
@{ ViewData["Title"] = "Choose a new password"; }
<div class="page"><section class="form-panel"><h1 class="mb-6 text-3xl font-semibold">Choose a new password</h1><form method="post" class="space-y-5"><div asp-validation-summary="All" role="alert"></div><input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" data-account-token /><div><label asp-for="Password" class="mb-2 block"></label><input asp-for="Password" class="field" autocomplete="new-password" /></div><button class="button w-full">Reset password</button></form></section></div>
@section Scripts { <script src="~/js/account-token.js" asp-append-version="true"></script> }
