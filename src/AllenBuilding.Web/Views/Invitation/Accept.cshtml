@model ActivationForm
@{ ViewData["Title"] = "Activate your invitation"; }
<div class="page"><section class="form-panel"><h1 class="mb-3 text-3xl font-semibold">Your office starts here</h1><p class="mb-6 text-muted">Choose a password between 12 and 128 characters to activate your office. A long passphrase is welcome; numbers, capitals and symbols are optional.</p><form method="post" class="space-y-5"><div asp-validation-summary="All" role="alert"></div><input asp-for="InvitationId" type="hidden" /><input asp-for="Token" type="hidden" data-account-token /><div><label asp-for="Password" class="mb-2 block"></label><input asp-for="Password" class="field" autocomplete="new-password" /></div><div><label asp-for="ConfirmPassword" class="mb-2 block">Confirm password</label><input asp-for="ConfirmPassword" class="field" autocomplete="new-password" /></div><button class="button w-full">Activate access</button></form><noscript><p class="mt-4">JavaScript is required to securely read the invitation link.</p></noscript></section></div>
@section Scripts { <script src="~/js/account-token.js" asp-append-version="true"></script> }
