@using AllenBuilding.Application.Billing
@using AllenBuilding.Domain.Billing
@model IReadOnlyList<AutopayView>
@{ var account = (BillingAccount)ViewData["Account"]!; ViewData["Title"] = "Monthly autopay"; }
<div class="page"><p class="mb-2 text-sm text-muted">YOUR RENT ACCOUNT</p><h1 class="mb-3 text-4xl font-semibold">Monthly autopay</h1><p class="mb-6 break-words text-muted">@account.Suite</p>
    @if (TempData["Notice"] is string notice) { <p role="status" class="mb-6 rounded-xl border border-line bg-panel p-4">@notice</p> }
    <p class="mb-6 max-w-3xl text-muted">Autopay uses your manager-set monthly rent and due day. Consent does not make a payment. Already-issued charges, past rent and one-time charges remain separate.</p>
    <ul class="mb-8 grid gap-4 md:grid-cols-2">@foreach (var authorization in Model) {
        <li class="min-w-0 rounded-2xl border border-line bg-panel p-5"><h2 class="mb-3 text-xl font-semibold">@BillingDisplay.Usd(authorization.MonthlyMinorUnits) USD per month</h2>
            <p class="mb-3">@(authorization.State switch { AutopayState.AwaitingMethod => "Preparing payment-method setup", AutopayState.AwaitingProvider => "Checking provider setup", AutopayState.Active => "Verified active", AutopayState.StopPending => "Stop requested · verification pending", AutopayState.Stopped => "Verified stopped", _ => "Review required" })</p>
            <p class="text-muted">Due day @authorization.DueDay, clamped to the last day of shorter months.</p><p class="mt-2">First rent month: @authorization.FirstPeriodStartsOn.ToString("yyyy-MM"); first due: @authorization.FirstDueOn.ToString("yyyy-MM-dd").</p>
            @if (authorization.EndsBefore is { } end) { <p class="mt-2">Authorized rent months end before @end.ToString("yyyy-MM-dd").</p> }
            @if (authorization.StopEffectiveAt is { } cutoff) { <p class="mt-3">Requested cutoff: @cutoff.ToString("yyyy-MM-dd HH:mm 'UTC'"). Cancellation is confirmed only after provider verification.</p> }
            @if (authorization.State is not (AutopayState.Stopped or AutopayState.StopPending)) {
                <form asp-action="PrepareStop" method="post" class="mt-5 space-y-3"><input type="hidden" name="id" value="@authorization.Id" />
                    <label for="stop-@authorization.Id" class="block">When to stop</label><select id="stop-@authorization.Id" name="timing" class="field"><option value="Immediately">Immediately</option><option value="EndOfCurrentRentMonth">End of the current rent month</option></select><button class="quiet-button">Review stopping autopay</button></form>
            }
        </li>
    }</ul>
    @if (!Model.Any(x => x.State != AutopayState.Stopped)) {
        <section class="mb-6 rounded-2xl border border-line bg-panel p-6"><h2 class="mb-3 text-xl font-semibold">Review enrollment</h2><p class="mb-5 text-muted">The next eligible whole month is reviewed first. No current or partial month is collected at enrollment. Financial holds or a later paid/adjusted month require management review.</p>
            <form asp-action="Prepare" method="post" class="space-y-4"><input type="hidden" name="accountId" value="@account.Id" /><label for="agreement" class="block">Approved rent agreement</label><select id="agreement" name="agreementId" required class="field">@foreach (var terms in account.Terms.Where(x => x.SupersededBy == null)) { <option value="@terms.Id">@BillingDisplay.Usd(terms.AmountMinorUnits) · due day @terms.DueDay · from @terms.StartsOn.ToString("yyyy-MM-dd")</option> }</select><button class="button">Review monthly autopay</button></form>
        </section>
    }
    <a asp-controller="Billing" asp-action="Account" asp-route-id="@account.Id" class="quiet-button">Return to billing account</a>
</div>
