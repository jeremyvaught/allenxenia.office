@model AllenBuilding.Application.Reporting.CompletionReport
@using AllenBuilding.Application.Reporting
@{ ViewData["Title"] = "Maintenance completion times";
    string Duration(double? seconds) => seconds is null ? "Not enough data yet" : seconds >= 86400 ? $"{seconds / 86400:0.0} days" : seconds >= 3600 ? $"{seconds / 3600:0.0} hours" : seconds >= 60 ? $"{seconds / 60:0.0} minutes" : $"{seconds:0.0} seconds";
}
<div class="page">
    <partial name="_ReportLinks" /><h1 class="mb-4 text-4xl font-semibold">Maintenance completion times</h1>
    <p class="mb-4 max-w-3xl text-muted">How long repairs take from the day a request is submitted, and how long finished work waits for you to verify and close it.</p>
    <p class="mb-6 text-sm text-muted">As of @OfficeTime.Timestamp(Model.ObservedAt, true), across all recorded requests.</p>
    <form method="get" class="mb-8 grid items-end gap-4 rounded-2xl border border-line bg-panel p-5 sm:grid-cols-2">
        <div class="min-w-0 flex-1"><label for="completion-building" class="mb-2 block">Building</label><select id="completion-building" name="BuildingId" class="field"><option value="">All managed buildings</option>@foreach (var building in Model.Buildings) { <option value="@building.Id" selected="@(Model.Query.BuildingId == building.Id)">@building.Name</option> }</select></div><button class="button">View report</button>
    </form>
    <section aria-label="Workflow duration summaries" class="grid gap-5 sm:grid-cols-2">
        @foreach (var pair in new[] { (Label: "Time to repair", Summary: Model.Completion), (Label: "Time to verify and close", Summary: Model.Verification) }) {
            <div class="rounded-2xl border border-line bg-panel p-6"><h2 class="text-xl font-semibold">@pair.Label</h2><p class="mt-3 text-sm text-muted">Based on @pair.Summary.Samples @(pair.Summary.Samples == 1 ? "request" : "requests")</p><dl class="mt-5 space-y-4"><div><dt class="text-sm text-muted">Typical (median)</dt><dd class="text-2xl font-semibold">@Duration(pair.Summary.MedianSeconds)</dd></div><div><dt class="text-sm text-muted">Slowest cases (95th percentile)</dt><dd class="text-2xl font-semibold">@Duration(pair.Summary.P95Seconds)</dd></div></dl></div>
        }
    </section>
    <p class="mt-6 text-muted">@Model.Cycles submitted or reopened · @Model.Unresolved still open · @Model.Cancelled cancelled. Open and cancelled requests are not included in the times above.</p>
    @if (Model.AmbiguousRequests > 0) { <p class="mt-4 rounded-xl border border-line bg-panel p-4">@Model.AmbiguousRequests requests are left out because their recorded times are out of order. Their histories are still available on each request.</p> }
    <p class="mt-4 text-sm text-muted">Times include evenings and weekends.</p>
</div>
