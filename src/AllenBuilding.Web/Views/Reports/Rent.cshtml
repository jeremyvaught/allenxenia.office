@model AllenBuilding.Application.Reporting.RentBalanceReport
@using AllenBuilding.Application.Reporting
@using System.Globalization
@{ ViewData["Title"] = "Rent balances"; var query = Model.Query;
    string Money(long minor) => (minor / 100m).ToString("C", CultureInfo.GetCultureInfo("en-US"));
    string Label(RentBalanceGroup group) => group switch { RentBalanceGroup.Overdue => "Overdue", RentBalanceGroup.Held => "Held for reconciliation", _ => "All outstanding" };
}
<div class="page">
    <p class="mb-2 text-sm text-muted">BUILDING MANAGEMENT · REPORTS</p><h1 class="mb-4 text-4xl font-semibold">Rent balances</h1>
    <p class="mb-3 max-w-3xl text-muted">Positive balances on issued rent and one-time charges, including older debt and ended tenancies. Recorded credits reduce debt; verified payment allocations and refund reversals change paid amounts. Pending provider work does not establish a payment.</p>
    <p class="mb-6 text-sm text-muted">App snapshot @OfficeTime.Timestamp(Model.ObservedAt, true) · Overdue after the due date in America/New_York (@Model.LocalDate.ToString("yyyy-MM-dd")). This is a current database read, not a fresh Stripe verification or a historical reconstruction.</p>
    <section aria-label="Recorded balance totals" class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var entry in new[] { ("Recorded outstanding", Model.Totals.ConfirmedMinor), ("Overdue", Model.Totals.OverdueMinor), ("Held for reconciliation", Model.Totals.HeldMinor), ("Without a recorded hold", Model.Totals.UnheldMinor) }) {
            <div class="rounded-2xl border border-line bg-panel p-5"><span class="block text-sm text-muted">@entry.Item1</span><strong class="mt-2 block break-words text-3xl font-semibold">@Money(entry.Item2)</strong></div>
        }
    </section>
    <p class="mb-6 max-w-3xl text-muted">Pending billing cleanup or an unresolved account-wide exception or cash movement holds every charge in that rent account. Held balances remain in recorded outstanding and overdue totals; they must be resolved before collection. An amount without a recorded hold still requires a fresh authorized payment review. Unresolved cash movements below can make affected account records provisional.</p>
    <section aria-label="Overdue aging" class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var entry in new[] { ("1–30 days", Model.Totals.From1To30DaysMinor), ("31–60 days", Model.Totals.From31To60DaysMinor), ("61–90 days", Model.Totals.From61To90DaysMinor), ("Over 90 days", Model.Totals.Over90DaysMinor) }) {
            <div class="rounded-2xl border border-line bg-panel p-5"><span class="block text-sm text-muted">@entry.Item1</span><strong class="mt-2 block text-xl">@Money(entry.Item2)</strong></div>
        }
    </section>
    <section aria-label="Unresolved financial work" class="mb-6 rounded-2xl border border-line bg-panel p-5">
        <h2 class="mb-3 text-xl font-semibold">Unresolved financial work</h2><p>@Model.Totals.OpenExceptions open or escalated @(Model.Totals.OpenExceptions == 1 ? "exception" : "exceptions")</p>
        <p class="mt-2">Refund gross awaiting agreement: @Money(Model.Totals.UnresolvedRefundMinor)</p><p class="mt-2">Dispute withdrawals awaiting agreement: @Money(Model.Totals.UnresolvedDisputeWithdrawalMinor)</p>
        <p class="mt-3 text-sm text-muted">These are separate provider movement amounts, counted once per movement. They are not extra debt, fees, a collectible total, or amounts to add to the balance above. A provider movement has no inferred charge allocation.</p>
        <a asp-controller="FinancialExceptions" asp-action="Index" class="quiet-button mt-4">Review financial exceptions</a>
    </section>
    <form method="get" class="mb-6 grid gap-5 rounded-2xl border border-line bg-panel p-5 sm:grid-cols-2">
        <div><label for="balance-building" class="mb-2 block">Building</label><select id="balance-building" name="BuildingId" class="field"><option value="">All managed buildings</option>@foreach (var building in Model.Buildings) { <option value="@building.Id" selected="@(query.BuildingId == building.Id)">@building.Name</option> }</select></div>
        <div><label for="balance-group" class="mb-2 block">Balance group</label><select id="balance-group" name="Group" class="field">@foreach (var group in Enum.GetValues<RentBalanceGroup>()) { <option value="@group" selected="@(query.Group == group)">@Label(group)</option> }</select></div>
        <div class="flex flex-wrap gap-3 sm:col-span-2"><button class="button">View report</button><a asp-action="Rent" class="quiet-button">Reset report</a></div>
    </form>
    <p class="mb-4 text-sm text-muted">@Model.Totals.Count outstanding charges · Page @query.Page · up to @RentBalanceQuery.PageSize per page. Totals cover the full selected building scope, regardless of group or page.</p>
    @if (Model.Items.Count == 0) { <p class="rounded-xl border border-line bg-panel p-6">No outstanding charges in this group.</p> }
    <ul class="grid gap-4">@foreach (var item in Model.Items) {
        <li class="rounded-2xl border border-line bg-panel p-5"><h2 class="break-words text-xl font-semibold">@item.Description</h2><p class="mt-2 text-muted">@item.Building · @item.Suite</p><p class="mt-2">@Money(item.ConfirmedMinor) recorded balance · Due @item.DueOn.ToString("yyyy-MM-dd")</p>
            <p class="mt-2 text-sm">@(item.Held ? "Held for reconciliation" : "No recorded hold")</p><a asp-controller="Billing" asp-action="ManageAccount" asp-route-id="@item.AccountId" class="quiet-button mt-4">Review rent account</a></li>
    }</ul>
    <nav aria-label="Report pages" class="mt-6 flex flex-wrap gap-3">@if (query.Page > 1) { <a asp-action="Rent" asp-route-BuildingId="@query.BuildingId" asp-route-Group="@query.Group" asp-route-Page="@(query.Page - 1)" class="quiet-button">Previous page</a> }@if (Model.HasNext) { <a asp-action="Rent" asp-route-BuildingId="@query.BuildingId" asp-route-Group="@query.Group" asp-route-Page="@(query.Page + 1)" class="quiet-button">Next page</a> }</nav>
    <div class="mt-8 flex flex-wrap gap-3"><a asp-controller="Billing" asp-action="Manage" class="quiet-button">Manage billing</a><a asp-action="Maintenance" class="quiet-button">Maintenance aging</a><a asp-controller="Portal" asp-action="Index" class="quiet-button">Your office</a></div>
</div>
