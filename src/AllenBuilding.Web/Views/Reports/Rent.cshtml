@model AllenBuilding.Application.Reporting.RentBalanceReport
@using AllenBuilding.Application.Reporting
@{
    ViewData["Title"] = "Rent balances"; var query = Model.Query;
    var review = ViewData["FinancialReview"] is true;
    string Label(RentBalanceGroup group) => group switch { RentBalanceGroup.Overdue => "Overdue only", RentBalanceGroup.Held => "On hold only", _ => "Everything owed" };
    const string tile = "rounded-xl border border-line bg-panel p-5";
}
<div class="page">
    <partial name="_ReportLinks" />
    <h1 class="mb-3 text-4xl font-semibold">Rent balances</h1>
    <p class="mb-3 max-w-3xl text-muted">Rent and one-time charges that are not fully settled, including those of tenants who have left. Credits a manager has recorded count against what is owed.</p>
    <p class="mb-6 text-sm text-muted">As of @OfficeTime.Timestamp(Model.ObservedAt, true). A charge is overdue from the day after its due date.</p>
    <ul aria-label="Totals" class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-@(review ? 4 : 2)">
        <li class="@tile"><span class="block text-3xl font-semibold">@BillingDisplay.Usd(Model.Totals.ConfirmedMinor)</span><span class="mt-1 block text-sm text-muted">Owed in total</span></li>
        <li class="@tile"><span class="block text-3xl font-semibold">@BillingDisplay.Usd(Model.Totals.OverdueMinor)</span><span class="mt-1 block text-sm text-muted">Of that, overdue</span></li>
        @if (review)
        {
            <li class="@tile"><span class="block text-3xl font-semibold">@BillingDisplay.Usd(Model.Totals.HeldMinor)</span><span class="mt-1 block text-sm text-muted">On hold until a payment problem is sorted out</span></li>
            <li class="@tile"><span class="block text-3xl font-semibold">@BillingDisplay.Usd(Model.Totals.UnheldMinor)</span><span class="mt-1 block text-sm text-muted">Not on hold</span></li>
        }
    </ul>
    <h2 class="mb-3 text-xl font-semibold">How long overdue</h2>
    <ul aria-label="Overdue by age" class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var entry in new[] { ("1 to 30 days", Model.Totals.From1To30DaysMinor), ("31 to 60 days", Model.Totals.From31To60DaysMinor), ("61 to 90 days", Model.Totals.From61To90DaysMinor), ("Over 90 days", Model.Totals.Over90DaysMinor) }) {
            <li class="@tile"><span class="block text-xl font-semibold">@BillingDisplay.Usd(entry.Item2)</span><span class="mt-1 block text-sm text-muted">@entry.Item1</span></li>
        }
    </ul>
    @if (review)
    {
        <section aria-label="Payment problems waiting" class="mb-8 rounded-2xl border border-line bg-panel p-5">
            <h2 class="mb-3 text-xl font-semibold">Payment problems waiting</h2><p>@Model.Totals.OpenExceptions open @(Model.Totals.OpenExceptions == 1 ? "exception" : "exceptions")</p>
            <p class="mt-2">Refunds not yet matched: @BillingDisplay.Usd(Model.Totals.UnresolvedRefundMinor)</p><p class="mt-2">Dispute withdrawals not yet matched: @BillingDisplay.Usd(Model.Totals.UnresolvedDisputeWithdrawalMinor)</p>
            <p class="mt-3 text-sm text-muted">These are amounts moved by the payment provider. They are not extra debt and are not added to the totals above. While one is open, every charge on that account is on hold.</p>
            <a asp-controller="FinancialExceptions" asp-action="Index" class="quiet-button mt-4">Review financial exceptions</a>
        </section>
    }
    <form method="get" class="mb-6 grid items-end gap-4 rounded-2xl border border-line bg-panel p-5 sm:grid-cols-[1fr_1fr_auto]">
        <div><label for="balance-building" class="mb-2 block">Building</label><select id="balance-building" name="BuildingId" class="field"><option value="">All my buildings</option>@foreach (var building in Model.Buildings) { <option value="@building.Id" selected="@(query.BuildingId == building.Id)">@building.Name</option> }</select></div>
        <div><label for="balance-group" class="mb-2 block">Show</label><select id="balance-group" name="Group" class="field">@foreach (var group in Enum.GetValues<RentBalanceGroup>().Where(x => review || x != RentBalanceGroup.Held || query.Group == x)) { <option value="@group" selected="@(query.Group == group)">@Label(group)</option> }</select></div>
        <div class="flex flex-wrap gap-3"><button class="button">View report</button><a asp-action="Rent" class="quiet-button">Reset report</a></div>
    </form>
    <p class="mb-4 text-sm text-muted">@Model.Totals.Count @(Model.Totals.Count == 1 ? "charge" : "charges") with something owed@(query.Page > 1 || Model.HasNext ? " · page " + query.Page : ""). The totals above cover every charge, whatever is listed below.</p>
    @if (Model.Items.Count == 0) { <p class="rounded-xl border border-line bg-panel p-6">@(query.Group == RentBalanceGroup.Outstanding ? "Nothing is owed." : "No charges match.")</p> }
    else
    {
        <ul class="divide-y divide-line rounded-2xl border border-line bg-panel">@foreach (var item in Model.Items) {
            var late = Model.LocalDate.DayNumber - item.DueOn.DayNumber;
            <li class="flex min-w-0 flex-wrap items-center justify-between gap-4 p-5"><div class="min-w-0"><h2 class="break-words font-semibold">Suite @item.Suite · @BillingDisplay.Charge(item.Description)</h2>
                <p class="mt-1 text-sm text-muted">@item.Building · @BillingDisplay.Usd(item.ConfirmedMinor) owed · Due @BillingDisplay.Day(item.DueOn)@(late > 0 ? " · " + late + (late == 1 ? " day overdue" : " days overdue") : "")@(item.Held && review ? " · On hold" : "")</p></div>
                <a asp-controller="Billing" asp-action="ManageAccount" asp-route-id="@item.AccountId" class="quiet-button">Open suite @item.Suite billing</a></li>
        }</ul>
    }
    <nav aria-label="Report pages" class="mt-6 flex flex-wrap gap-3">@if (query.Page > 1) { <a asp-action="Rent" asp-route-BuildingId="@query.BuildingId" asp-route-Group="@query.Group" asp-route-Page="@(query.Page - 1)" class="quiet-button">Previous page</a> }@if (Model.HasNext) { <a asp-action="Rent" asp-route-BuildingId="@query.BuildingId" asp-route-Group="@query.Group" asp-route-Page="@(query.Page + 1)" class="quiet-button">Next page</a> }</nav>
    <a asp-controller="Billing" asp-action="Manage" class="mt-6 flex min-h-11 items-center underline">Back to billing</a>
</div>
