@model IReadOnlyList<AllenBuilding.Domain.Tenancy.Membership>
@{ ViewData["Title"] = "Your office"; }
<div class="page"><p class="mb-2 text-sm text-muted">ALLEN BUILDING</p><h1 class="mb-6 text-4xl font-semibold">Your office</h1>
@if (ViewData["Manager"] is true) { <a asp-controller="Management" asp-action="Index" class="button mb-6">Manage building access</a> }
@if (Model.Count == 0) { <p class="rounded-xl border border-line bg-panel p-6">No active tenant membership. Contact your building manager if you need access.</p> }
else { <p class="mb-5 text-muted">Your active tenant access is confirmed. Maintenance services are being connected.</p> }
</div>
