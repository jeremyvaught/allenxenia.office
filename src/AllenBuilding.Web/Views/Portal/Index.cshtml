@model IReadOnlyList<AllenBuilding.Domain.Tenancy.Membership>
@{ ViewData["Title"] = "Your office"; }
<div class="page"><p class="mb-2 text-sm text-muted">ALLEN BUILDING</p><h1 class="mb-6 text-4xl font-semibold">Your office</h1>
@if (ViewData["Manager"] is true) { <div class="mb-6 flex flex-wrap gap-3"><a asp-controller="Management" asp-action="Index" class="quiet-button">Manage building access</a><a asp-controller="Maintenance" asp-action="Manage" class="button">Manage maintenance</a><a asp-controller="Reports" asp-action="Maintenance" class="quiet-button">Maintenance aging report</a><a asp-controller="Knowledge" asp-action="Manage" class="quiet-button">Manage building help</a><a asp-controller="Contractors" asp-action="Index" class="quiet-button">Contractor contacts</a><a asp-controller="Notifications" asp-action="Index" class="quiet-button">Notification delivery</a>@if (ViewData["BillingEnabled"] is true) { <a asp-controller="Billing" asp-action="Manage" class="quiet-button">Manage billing</a> }</div> }
@if (Model.Count == 0) { <p class="rounded-xl border border-line bg-panel p-6">No active tenant membership. Contact your building manager if you need access.</p> }
else { <p class="mb-5 text-muted">Report a maintenance issue, follow progress, and keep the conversation in one place.</p><div class="flex flex-wrap gap-3"><a asp-controller="Maintenance" asp-action="Create" class="button">Report an issue</a><a asp-controller="Maintenance" asp-action="Index" class="quiet-button">Your requests</a><a asp-controller="Knowledge" asp-action="Tenant" class="quiet-button">Building help</a>@if (ViewData["BillingEnabled"] is true) { <a asp-controller="Billing" asp-action="Index" class="quiet-button">Your billing records</a> }</div> }
</div>
