@model IReadOnlyList<AllenBuilding.Application.Maintenance.ContractorDetails>
@{ ViewData["Title"] = "Contractor contacts"; }
<div class="page">
    <a asp-controller="Portal" asp-action="Index" class="mb-6 flex min-h-11 items-center underline">Back to your office</a>
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-semibold">Contractor contacts</h1><a asp-action="Create" class="button">Add a contractor</a></div>
    <p class="mb-6 text-muted">Contacts are visible to management. Deactivation prevents new assignments and keeps previous work on record.</p>
    @if (Model.Count == 0) { <p class="rounded-2xl border border-line bg-panel p-6">No contractor contacts yet.</p> }
    <div class="grid gap-4 md:grid-cols-2">
    @foreach (var contact in Model)
    {
        <article class="min-w-0 rounded-2xl border border-line bg-panel p-6"><h2 class="break-words text-xl font-semibold">@contact.Name</h2><p class="mt-2 text-sm text-muted">@MaintenanceText.Trade(contact.Trade) · @(contact.Active ? "Active" : "Inactive")</p>
            @if (contact.Email != "") { <p class="mt-3 break-words">@contact.Email</p> }
            @if (contact.Phone != "") { <p class="mt-2 break-words">@contact.Phone</p> }
            <a asp-action="Edit" asp-route-id="@contact.Id" class="quiet-button mt-4">Edit @contact.Name</a></article>
    }
    </div>
    @if (Model.Count == 100) { <p class="mt-4 text-muted">Showing the first 100 contacts.</p> }
</div>
