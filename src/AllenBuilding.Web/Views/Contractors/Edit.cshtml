@model ContractorForm
@using AllenBuilding.Domain.Maintenance
@{ ViewData["Title"] = Model.Version is null ? "Add a contractor" : "Edit contractor"; }
<div class="page"><a asp-action="Index" class="mb-6 flex min-h-11 items-center underline">Back to contacts</a>
    <div class="form-panel"><h1 class="mb-6 text-3xl font-semibold">@ViewData["Title"]</h1>
        <form asp-action="Save" method="post" class="space-y-4">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
            <label asp-for="BuildingId" class="block">Building</label>
            @if (Model.Version is null) { <select asp-for="BuildingId" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Buildings"]!)" class="field"></select> }
            else { <input asp-for="BuildingId" type="hidden" /><p class="text-muted">The building cannot be changed.</p> }
            <label asp-for="Name" class="block">Contact name</label><input asp-for="Name" maxlength="160" required class="field" />
            <label asp-for="Trade" class="block"></label><select asp-for="Trade" asp-items="Html.GetEnumSelectList<Trade>()" class="field"></select>
            <label asp-for="Email" class="block">Email (optional)</label><input asp-for="Email" type="email" maxlength="254" autocomplete="email" class="field" />
            <label asp-for="Phone" class="block">Phone (optional)</label><input asp-for="Phone" type="tel" maxlength="80" autocomplete="tel" class="field" />
            @if (Model.Version is not null) { <label class="flex min-h-11 items-center gap-3"><input asp-for="Active" /> Active — available for new assignments</label> }
            else { <input name="Active" value="true" type="hidden" /> }
            <button class="button w-full">Save contact</button>
        </form>
    </div>
</div>
