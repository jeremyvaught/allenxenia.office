@model IReadOnlyList<AllenBuilding.Application.Knowledge.HelpSource>
@{ ViewData["Title"] = "Building help"; var tenant = ViewData["Tenant"] is true; }
<div class="page"><h1 class="mb-3 text-3xl font-semibold sm:text-4xl">Building help</h1><p class="mb-6 text-muted">Guidance published by building management.</p>
    <form asp-action="@(tenant ? "Tenant" : "Index")" method="get" class="mb-8 flex flex-wrap items-end gap-3"><div class="min-w-0 flex-1"><label for="search" class="mb-2 block">Search building help</label><input id="search" name="search" value="@ViewData["Search"]" maxlength="120" type="search" class="field" /></div><button class="button">Search</button></form>
    @if (Model.Count == 0) { <p class="rounded-2xl border border-line bg-panel p-6">No published guidance matches this view. Contact building management for information that is missing.</p> }
    <div class="grid gap-4 md:grid-cols-2">
    @foreach (var article in Model)
    {
        <article class="min-w-0 rounded-2xl border border-line bg-panel p-6"><p class="mb-2 text-sm text-muted">@article.Building @(article.Audience == AllenBuilding.Domain.Knowledge.ArticleAudience.ActiveTenant ? "· Tenant guidance" : "")</p><h2 class="break-words text-xl font-semibold"><a asp-action="@(tenant ? "TenantArticle" : "Article")" asp-route-id="@article.ArticleId" class="block min-h-11 underline">@article.Title</a></h2><p class="mt-3 text-sm text-muted">Review date: @article.ReviewOn.ToString("MMM d, yyyy")</p></article>
    }
    </div>
    @if (Model.Count == 100) { <p class="mt-4 text-muted">Showing the first 100 matching articles. Narrow your search to find more.</p> }
</div>
