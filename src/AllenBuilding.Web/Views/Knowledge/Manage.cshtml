@model IReadOnlyList<AllenBuilding.Application.Knowledge.ArticleEditor>
@{ ViewData["Title"] = "Manage building help"; }
<div class="page"><a asp-controller="Portal" asp-action="Index" class="mb-6 flex min-h-11 items-center underline">Back to your office</a>
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-semibold">Manage building help</h1><a asp-action="Create" class="button">Write an article</a></div>
    @if (Model.Count == 0) { <p class="rounded-2xl border border-line bg-panel p-6">No articles yet. Add approved guidance about building access, maintenance, payments or contact routes.</p> }
    <div class="grid gap-4 md:grid-cols-2">
    @foreach (var article in Model)
    {
        <article class="min-w-0 rounded-2xl border border-line bg-panel p-6"><h2 class="break-words text-xl font-semibold">@article.Draft.Title</h2><p class="mt-3 text-sm text-muted">@article.State · @(article.Draft.Audience == AllenBuilding.Domain.Knowledge.ArticleAudience.Public ? "Public" : "Active tenants")</p>
            @if (article.State == AllenBuilding.Domain.Knowledge.PublicationState.Published && article.PublishedRevisionId != article.Draft.Id) { <p class="mt-2 text-sm text-muted">Unpublished edits; the previous approved revision is visible.</p> }
            <a asp-action="Edit" asp-route-id="@article.Id" class="quiet-button mt-4">Edit @article.Draft.Title</a></article>
    }
    </div>
    @if (Model.Count == 100) { <p class="mt-4 text-muted">Showing the first 100 articles.</p> }
</div>
