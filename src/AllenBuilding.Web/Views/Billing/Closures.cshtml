@model IReadOnlyList<AllenBuilding.Application.Billing.BillingClosureItem>
@{ ViewData["Title"] = "Ended tenancies"; }
<div class="page"><h1 class="mb-4 text-4xl font-semibold">Ended tenancies with cleanup pending</h1>
    <p class="mb-6 max-w-3xl text-muted">These tenants have lost portal access and can no longer be charged. Anything set up with the payment provider for them still has to be checked. Being listed here does not mean payments have stopped or that a debt is forgiven.</p>
    @if (Model.Count == 0) { <p class="mb-6 rounded-2xl border border-line bg-panel p-6">No ended tenancies are waiting for cleanup.</p> }
    <ul class="grid gap-4">@foreach (var item in Model) { <li class="rounded-2xl border border-line bg-panel p-5"><h2 class="break-words text-xl font-semibold">Suite @item.Suite</h2><p class="mt-2 break-words text-muted">@item.PayerEmail</p><p class="mt-2">Waiting since @OfficeTime.Timestamp(item.RequestedAt)</p><p class="mt-3 break-words">@item.Reason</p><a asp-action="ManageAccount" asp-route-id="@item.AccountId" class="quiet-button mt-4">Open this account</a></li> }</ul>
    @if (Model.Count == 50) { <p class="mt-5 text-sm text-muted">Showing the 50 oldest cases.</p> }
    <div class="mt-6 flex flex-wrap gap-3"><a asp-action="Manage" class="quiet-button">Back to billing</a>@if (ViewData["FinancialReview"] is true) { <a asp-controller="FinancialExceptions" asp-action="Index" class="quiet-button">Financial exceptions</a> }</div>
</div>
