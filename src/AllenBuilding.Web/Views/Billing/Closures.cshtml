@model IReadOnlyList<AllenBuilding.Application.Billing.BillingClosureItem>
@{ ViewData["Title"] = "Pending billing closures"; }
<div class="page"><p class="mb-2 text-sm text-muted">BUILDING MANAGEMENT · BILLING</p><h1 class="mb-4 text-4xl font-semibold">Pending billing closures</h1>
    <p class="mb-6 max-w-3xl text-muted">These tenancies have already lost portal access and new ordinary billing. Provider cleanup, unpaid instructions and already-dispatched payments remain to be reconciled. A pending case does not mean Stripe collection has stopped or debt has been forgiven.</p>
    @if (Model.Count == 0) { <p class="mb-6 rounded-2xl border border-line bg-panel p-6">No pending billing closures in your managed buildings.</p> }
    <ul class="grid gap-4">@foreach (var item in Model) { <li class="rounded-2xl border border-line bg-panel p-5"><h2 class="break-words text-xl font-semibold">@item.Suite</h2><p class="mt-2 break-words text-muted">@item.PayerEmail</p><p class="mt-2">Cleanup pending since @item.RequestedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</p><p class="mt-3 break-words">@item.Reason</p><a asp-action="ManageAccount" asp-route-id="@item.AccountId" class="quiet-button mt-4">Review closed tenancy account</a></li> }</ul>
    <p class="mt-5 text-sm text-muted">Up to 50 unresolved cases, oldest first. No automatic provider cleanup worker is enabled yet. Resolve provider instructions through the authorized reconciliation workflow; this page has no manual “verified” switch.</p>
    <div class="mt-6 flex flex-wrap gap-3"><a asp-action="Manage" class="quiet-button">Manage billing</a><a asp-controller="FinancialExceptions" asp-action="Index" class="quiet-button">Financial exceptions</a></div>
</div>
