@model IReadOnlyList<AllenBuilding.Application.Billing.BillingAccount>
@{ ViewData["Title"] = "Your billing"; var today = (DateOnly)ViewData["Today"]!; }
<div class="page">
    <h1 class="mb-3 text-4xl font-semibold">Your billing</h1>
    <p class="mb-6 max-w-3xl text-muted">Rent terms, charges and what you owe for each of your suites.</p>
    @if (Model.Count == 0) { <p class="rounded-xl border border-line bg-panel p-6">No rent account has been set up for your suite yet. Ask building management if you have a billing question.</p> }
    else
    {
        <ul class="divide-y divide-line rounded-2xl border border-line bg-panel">
        @foreach (var account in Model)
        {
            <li class="flex flex-wrap items-center justify-between gap-4 p-5"><div><h2 class="text-xl font-semibold">Suite @account.Suite</h2><p class="mt-1 text-sm text-muted">@BillingDisplay.Usd(account.BalanceMinorUnits) owed@(account.OverdueMinorUnits(today) > 0 ? " · " + BillingDisplay.Usd(account.OverdueMinorUnits(today)) + " overdue" : "")</p></div><a asp-action="Account" asp-route-id="@account.Id" class="quiet-button">View suite @account.Suite billing</a></li>
        }
        </ul>
    }
</div>
