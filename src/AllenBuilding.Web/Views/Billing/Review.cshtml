@model AllenBuilding.Web.Security.BillingReviewPage
@{ ViewData["Title"] = "Check before saving"; }
<div class="page"><section class="mx-auto max-w-2xl rounded-2xl border border-line bg-panel p-6 sm:p-8">
    <p class="mb-2 text-sm text-muted">Check before saving</p><h1 class="mb-4 break-words text-3xl font-semibold">@Model.Review.Heading</h1>
    <p class="mb-6 break-words text-muted">@Model.Review.AccountLabel</p>
    <dl class="space-y-5">@foreach (var line in Model.Review.Lines) { <div><dt class="text-sm text-muted">@line.Label</dt><dd class="mt-1 break-words font-medium">@line.Value</dd></div> }</dl>
    <p class="my-6 text-sm text-muted">Nothing is saved until you confirm. This page expires after five minutes.</p>
    <form asp-action="Confirm" method="post"><input name="Ticket" value="@Model.Ticket" type="hidden" /><button class="button w-full sm:w-auto">Confirm and save</button></form>
    <a asp-action="Manage" class="mt-4 flex min-h-11 items-center underline">Go back without saving</a>
</section></div>
