@model AllenBuilding.Application.Billing.BillingCode
@{ ViewData["Title"] = "Billing change not saved"; }
<div class="page"><section class="mx-auto max-w-2xl rounded-2xl border border-line bg-panel p-6"><h1 class="mb-4 text-3xl font-semibold">This billing change was not saved</h1>
@if (Model == AllenBuilding.Application.Billing.BillingCode.Conflict) { <p>The account changed while you were working, or this change clashes with something already recorded. Open the account again and start over.</p> }
else if (Model == AllenBuilding.Application.Billing.BillingCode.NoFullPeriod) { <p>No rent terms cover that whole month. For a first or last partial month, add a one-time charge.</p> }
else { <p>Check the amount, dates and account. Amounts are in US dollars with at most two decimal places. A review page that has expired or been changed cannot be confirmed; start again from the account.</p> }
<div asp-validation-summary="All" role="alert" class="mt-4"></div><p class="mt-4 text-muted">Nothing was changed.</p><a asp-action="Manage" class="mt-6 quiet-button">Back to billing</a>
</section></div>
