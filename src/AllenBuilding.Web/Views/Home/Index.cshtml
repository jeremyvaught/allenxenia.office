@{ ViewData["Title"] = "Tenant portal"; }
<div class="mx-auto grid w-full max-w-5xl gap-10 px-5 py-12 sm:px-8 sm:py-20 md:grid-cols-2 md:items-center md:gap-16">
    <div>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Allen Building tenant portal</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">Report a maintenance problem, follow your requests and read building guidance. Access is by invitation from building management.</p>
        <div class="mt-7 flex flex-wrap gap-3">
            <a href="/Maintenance/Create" class="quiet-button">Report a maintenance issue</a>
            <a href="/Knowledge" class="quiet-button">Building help</a>
        </div>
    </div>
    <section aria-labelledby="sign-in-heading" class="form-panel">
        <h2 id="sign-in-heading" class="mb-2 text-2xl font-semibold">Sign in</h2>
        <p class="mb-6 text-muted">Use the email address from your building invitation.</p>
        <partial name="_SignInForm" model="new LoginForm()" />
    </section>
</div>
