@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <h1 class="text-3xl font-semibold tracking-tight">Something went wrong.</h1>
    <p class="mt-5 leading-relaxed text-muted">Please try again. If the problem continues, contact building management.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-5 break-all text-sm text-muted">Reference: @Model.RequestId</p>
    }
    <a href="/" class="mt-8 inline-flex min-h-11 items-center text-brand underline underline-offset-4">Back to Allen Xenia Office</a>
</section>
