@model ReauthenticateForm
@{ ViewData["Title"] = "Confirm it's you"; }
<div class="page"><section class="form-panel"><h1 class="mb-3 text-3xl font-semibold">Confirm it's you</h1><p class="mb-6 text-muted">Sensitive changes require your password and authenticator within the last five minutes.</p><form method="post" class="space-y-5"><div asp-validation-summary="All" role="alert"></div><div><label asp-for="Password" class="mb-2 block"></label><input asp-for="Password" class="field" autocomplete="current-password" /></div><div><label asp-for="Code" class="mb-2 block">Authenticator code</label><input asp-for="Code" class="field" inputmode="numeric" autocomplete="one-time-code" /></div><button class="button w-full">Verify</button></form></section></div>
