@{ ViewData["Title"] = "Access unavailable"; }
<div class="page"><section class="form-panel"><h1 class="mb-3 text-3xl font-semibold">Access unavailable</h1><p class="mb-5 text-muted">@(ViewData["CanReauthenticate"] is true ? "This action requires a recent verified sign-in." : "You do not have access to this area. Return to your office or ask your building manager for help.")</p>@if (ViewData["CanReauthenticate"] is true) { <a asp-action="Reauthenticate" class="button">Verify your sign-in</a> }<a asp-controller="Portal" asp-action="Index" class="mt-4 flex min-h-11 items-center underline">Return to your office</a></section></div>
