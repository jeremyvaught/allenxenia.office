@model FactorForm
@{ ViewData["Title"] = "Verify sign-in"; }
<div class="page"><section class="form-panel"><h1 class="mb-3 text-3xl font-semibold">One more step</h1><p class="mb-6 text-muted">Enter the code from your authenticator app. Your sign-in challenge expires after five minutes.</p><form method="post" class="space-y-5"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" role="alert"></div><div><label asp-for="Code" class="mb-2 block">Verification code</label><input asp-for="Code" class="field" autocomplete="one-time-code" /></div><label class="flex min-h-11 items-center gap-3"><input asp-for="Recovery" /> Use a recovery code</label><button class="button w-full">Verify sign-in</button></form></section></div>
