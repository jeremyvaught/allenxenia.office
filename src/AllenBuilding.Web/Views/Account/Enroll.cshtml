@model EnrollmentForm
@{ ViewData["Title"] = "Set up your authenticator"; }
<div class="page"><section class="form-panel"><h1 class="mb-3 text-3xl font-semibold">Protect your account</h1><p class="mb-5 text-muted">In your authenticator app, add a time-based account named Allen Xenia Office using this setup key. Keep the key private.</p><code class="mb-6 block break-all rounded-lg bg-brand-soft p-4">@Model.Key</code><form method="post" class="space-y-5"><div asp-validation-summary="All" role="alert"></div><div><label asp-for="Code" class="mb-2 block">Code from your authenticator</label><input asp-for="Code" class="field" inputmode="numeric" autocomplete="one-time-code" /></div><button class="button w-full">Verify and enable</button></form><p class="mt-5 text-sm text-muted">@(Model.FirstSetup ? "Verify your code once, save your recovery codes, then continue to your office." : "After recovery setup, sign in again with your password and authenticator, then save your recovery codes.")</p></section></div>
