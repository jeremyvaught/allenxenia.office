@model ReauthenticateForm
@{ ViewData["Title"] = "Replace recovery codes"; }
<div class="page"><section class="form-panel"><h1 class="mb-3 text-3xl font-semibold">Save a recovery route</h1><p class="mb-6 text-muted">Verify your password and authenticator to create ten new recovery codes. This replaces every previous code. Store the new codes securely outside this device.</p><form method="post" class="space-y-5"><div asp-validation-summary="All" role="alert"></div><div><label asp-for="Password" class="mb-2 block"></label><input asp-for="Password" class="field" autocomplete="current-password" /></div><div><label asp-for="Code" class="mb-2 block">Authenticator code</label><input asp-for="Code" class="field" inputmode="numeric" autocomplete="one-time-code" /></div><button class="button w-full">Replace recovery codes</button></form>
@if (User.HasClaim("office.recovery_session", "true"))
{
    <h2 class="mt-8 mb-3 text-xl font-semibold">Lost your authenticator?</h2><p class="mb-4 text-muted">Your recovery-code sign-in allows a new authenticator setup for five minutes. Verify your password to revoke existing sessions and recovery codes, then enroll a new device.</p>
    <form asp-action="RecoverAuthenticator" method="post" class="space-y-5"><label for="recovery-password" class="block">Password</label><input id="recovery-password" name="Password" type="password" class="field" autocomplete="current-password" required /><button class="quiet-button w-full">Reset authenticator and sign out</button></form>
}
</section></div>
