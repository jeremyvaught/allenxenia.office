@model AllenBuilding.Application.Notifications.NotificationInboxPage
@{ ViewData["Title"] = "Notifications"; }
<div class="page">
    <h1 class="mb-3 text-4xl font-semibold">Email notifications</h1>
    <p class="mb-6 text-muted">Emails the portal has sent or tried to send. Message text and reset links are never shown here.</p>
    <section class="mb-8" aria-labelledby="attention-heading">
        <h2 id="attention-heading" class="mb-4 text-2xl font-semibold">Needs attention</h2>
        <ul class="space-y-4">
        @foreach (var message in Model.NeedsAttention) { <partial name="_Notification" model="message" /> }
        </ul>
        @if (Model.NeedsAttention.Count == 0) { <p>Nothing needs attention.</p> }
        <nav aria-label="Delivery exceptions pages" class="mt-4 flex flex-wrap gap-4">
            @if (Model.ReviewPage > 1) { <a asp-action="Index" asp-route-reviewPage="@(Model.ReviewPage - 1)" class="quiet-button">Previous page</a> }
            @if (Model.HasNextPage) { <a asp-action="Index" asp-route-reviewPage="@(Model.ReviewPage + 1)" class="quiet-button">Next page</a> }
        </nav>
    </section>
    <section aria-labelledby="recent-heading">
        <h2 id="recent-heading" class="mb-4 text-2xl font-semibold">Recently sent</h2>
        <ul class="space-y-4">
        @foreach (var message in Model.Recent) { <partial name="_Notification" model="message" /> }
        </ul>
        @if (Model.Recent.Count == 0) { <p>No emails yet.</p> }
        @if (Model.Recent.Count == 100) { <p class="mt-4 text-muted">Showing the 100 most recent emails.</p> }
    </section>
    <a asp-controller="Account" asp-action="Reauthenticate" class="mt-6 flex min-h-11 items-center underline">Verify your sign-in to retry a failed email</a>
</div>
