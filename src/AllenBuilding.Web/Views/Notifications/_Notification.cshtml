@model AllenBuilding.Application.Notifications.NotificationRow
@using AllenBuilding.Domain.Tenancy
<li id="notification-@Model.Id" class="rounded-xl border border-line bg-panel p-5">
    <div class="flex flex-wrap justify-between gap-3"><h3 class="text-xl font-semibold">@(Model.Kind switch { "MaintenanceUpdate" => "Maintenance update", "SecurityNotice" => "Security notice", "PasswordReset" => "Password reset", _ => "Invitation" })</h3><span>@(Model.State switch { MessageState.NeedsReview => "Failed", MessageState.Queued => "Waiting to send", MessageState.Sending => "Sending", _ => Model.State.ToString() })</span></div>
    <p class="mt-2 text-sm text-muted">@OfficeTime.Timestamp(Model.CreatedAt)@(Model.Attempts > 0 ? " · tried " + Model.Attempts + (Model.Attempts == 1 ? " time" : " times") : "")</p>
    @if (Model.ResetRecipient is not null) { <p class="mt-2 break-words">Account: @Model.ResetRecipient</p> }
    @if (Model.State == MessageState.NeedsReview)
    {
        @if (Model.Kind == "PasswordReset")
        {
            <p class="mt-4 text-muted">This reset email could not be sent. Once email is working again, ask the tenant to request a new reset from the sign-in page; reset links expire after two hours, so this one is not resent.</p>
            <a asp-controller="Invitation" asp-action="Forgot" class="mt-4 quiet-button">Open password-reset request page</a>
        }
        else
        {
            <p class="mt-4 text-muted">@(Model.Error == "DeliveryUnknown" || Model.Error == "LeaseExpired" ? "We could not confirm whether this email was delivered. It may already have arrived, so check with the recipient before sending it again." : "This email could not be sent. Fix the email setup or provider problem before trying again.")</p>
            <form asp-controller="Notifications" asp-action="Retry" method="post" class="mt-4 space-y-3">
                <input name="Id" value="@Model.Id" type="hidden" /><input name="Version" value="@Model.Version" type="hidden" />
                <label for="reason-@Model.Id" class="block">Reason for sending again</label><input id="reason-@Model.Id" name="Reason" required maxlength="2000" class="field" />
                <button class="quiet-button">Send again</button>
            </form>
        }
    }
</li>
