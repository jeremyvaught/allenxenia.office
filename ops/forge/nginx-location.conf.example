# Merge only into this application's existing Forge HTTPS server block.
# Preserve Forge's certificate, ACME, includes and other sites. Confirm the upstream port.
location / {
    proxy_pass http://127.0.0.1:5081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Exactly one trusted local hop; replace client-supplied forwarding headers.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;
    proxy_buffering off;
    proxy_cache off;
    client_max_body_size 1m;
}
