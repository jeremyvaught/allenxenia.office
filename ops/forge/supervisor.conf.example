; Review ownership, paths, port, Linux x64 architecture and runtime-deps OS libraries on the actual Forge host.
; The verified self-contained package supplies .NET; publish servicing patches and redeploy to update it.
; Configure this program through Forge's daemon facility; do not replace its global Supervisor configuration.
[program:allen-office]
command=/srv/allen-office/current/AllenBuilding.Web --urls http://127.0.0.1:5081
directory=/srv/allen-office/current
user=allen-office
numprocs=1
autostart=true
autorestart=true
startsecs=10
startretries=3
stopsignal=TERM
stopwaitsecs=40
stopasgroup=true
killasgroup=true
umask=0077
environment=ASPNETCORE_ENVIRONMENT="Production",Office__RuntimeConfigFile="/srv/allen-office/private/runtime.json"
redirect_stderr=true
stdout_logfile=/srv/allen-office/logs/application.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
